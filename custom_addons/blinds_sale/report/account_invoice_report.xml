<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_invoice_inherit_hide_line_prices"
              inherit_id="account.report_invoice_document">

        <!-- ===== TABLE HEADERS ===== -->
        <xpath expr="//th[@name='th_priceunit']" position="replace"/>
        <xpath expr="//th[@name='th_discount']" position="replace"/>
        <xpath expr="//th[@name='th_taxes']" position="replace"/>
        <xpath expr="//th[@name='th_subtotal']" position="replace"/>

        <!-- ===== LINE VALUES ===== -->
        <!-- Unit price -->
        <xpath expr="//td[@name='td_price_unit']" position="replace"/>

        <!-- Discount -->
        <xpath expr="//td[@name='td_discount']" position="replace"/>

        <!-- Taxes -->
        <xpath expr="//td[@name='td_taxes']" position="replace"/>

        <!-- Subtotal -->
        <xpath expr="//td[@name='td_subtotal']" position="replace"/>

        <!-- ===== SECTION SUBTOTAL ===== -->
        <xpath expr="//tr[contains(@class,'is-subtotal')]" position="replace"/>

        <!-- ===== TOTALS / PAYMENTS / QR ===== -->
        <xpath expr="//div[@id='right-elements']" position="replace"/>

        <!-- Hide invoice line completely -->
        <xpath expr="//tbody[contains(@class, 'invoice_tbody')]//tr" position="attributes">
            <attribute name="t-if">
                line.display_type == 'combo' or not line.product_id.is_auto_hide
            </attribute>
        </xpath>

    </template>
</odoo>
