<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_account_move_form_inherit_blinds_sale" model="ir.ui.view">
        <field name="name">account.move.form.inherit.blinds.sale</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list//field[@name='product_id']" position="after">
                <field name="width"/>
                <field name="height"/>
                <field name="count"/>
                <field name="take_remains" optional="1"/>
            </xpath>
        </field>
    </record>
    
</odoo>